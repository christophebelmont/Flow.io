{"ok":true,"module":"io/drivers/expander00","docs":{"io/drivers/expander00/active_low":{"type":"Bool","label_t":"cfgdocs.io.drivers.expander00.active_low.label","help_t":"cfgdocs.io.drivers.expander.active_low.help","label":"Expander 00 actif a 0","label_i18n":"cfgdocs.io.drivers.expander00.active_low.label","help":"Inverse la polarite de toutes les sorties logiques de cette instance. Ce reglage se combine avec le parametre actif a 1 de chaque sortie.","help_i18n":"cfgdocs.io.drivers.expander.active_low.help"},"io/drivers/expander00/address":{"type":"UInt8","label_t":"cfgdocs.io.drivers.expander00.address.label","help_t":"cfgdocs.io.drivers.expander.address.help","display_format":"hex","label":"Adresse expander 00","label_i18n":"cfgdocs.io.drivers.expander00.address.label","help":"Adresse I2C utilisee pour cette instance d'expander IO.","help_i18n":"cfgdocs.io.drivers.expander.address.help"},"io/drivers/expander00/enabled":{"type":"Bool","label_t":"cfgdocs.io.drivers.expander00.enabled.label","help_t":"cfgdocs.io.drivers.expander.enabled.help","label":"Expander 00 actif","label_i18n":"cfgdocs.io.drivers.expander00.enabled.label","help":"Active cette instance d'expander IO.","help_i18n":"cfgdocs.io.drivers.expander.enabled.help"},"io/drivers/expander00/mask_default":{"type":"UInt8","label_t":"cfgdocs.io.drivers.expander00.mask_default.label","help_t":"cfgdocs.io.drivers.expander.mask_default.help","label":"Masque expander 00","label_i18n":"cfgdocs.io.drivers.expander00.mask_default.label","help":"Masque applique par defaut lorsque cette instance est utilisee comme sortie de masque.","help_i18n":"cfgdocs.io.drivers.expander.mask_default.help"}},"meta":{}}